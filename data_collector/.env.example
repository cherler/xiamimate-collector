# Collector runtime
# Phase 2 推荐：运行时共享路径继续指向旧基线；SQL bootstrap 切到 xiamimate-data-infra。
# 不要复制 .venv 目录。优先做法是：
# 1. phase 2 直接复用旧仓 xiamimate 的现有环境
# 2. 或者创建一个仓库外的公共 venv/conda 环境，然后把 XIAMIMATE_PYTHON_BIN 指过去
XIAMIMATE_BASELINE_ROOT=/absolute/path/to/xiamimate
XIAMIMATE_DATA_INFRA_ROOT=/absolute/path/to/xiamimate-data-infra
XIAMIMATE_PYTHON_BIN=/absolute/path/to/python
XIAMIMATE_DUCKDB_PATH=/absolute/path/to/local_analytics.duckdb
XIAMIMATE_RAW_JSON_ROOT=/absolute/path/to/shared/logs/raw-json
XIAMIMATE_RAW_PRODUCTS_DIR=/absolute/path/to/shared/logs/raw-json/products
XIAMIMATE_LOG_DIR=/absolute/path/to/shared/logs
XIAMIMATE_INIT_SYNC_TABLES_SQL=/absolute/path/to/xiamimate-data-infra/postgres/init_sync_tables.sql

# PostgreSQL connection for sync jobs
# 本地默认可以继续写 localhost:5432；切到 ECS -> RDS 后，这里必须改成 RDS 地址。
PG_HOST=localhost
PG_PORT=5432
PG_DB=xiamimate
PG_USER=xiamimate
PG_PASSWORD=xiamimate

# ECS / RDS 示例：
# PG_HOST=your-instance.pg.rds.aliyuncs.com
# PG_PORT=5432
# PG_DB=xiamimate
# PG_USER=xiamimate
# PG_PASSWORD=replace-with-rds-password

# 本地通过 SSH 隧道写 RDS 示例：
# 1. 保持 PG_* 指向 RDS 目标
# 2. 打开 PG_TUNNEL_ENABLED=1
# 3. start/preview/status 会自动使用 127.0.0.1:15432 作为本地转发入口
# PG_HOST=your-instance.pg.rds.aliyuncs.com
# PG_PORT=5432
# PG_DB=xiamimate
# PG_USER=xiamimate
# PG_PASSWORD=replace-with-rds-password
# PG_TUNNEL_ENABLED=1
# PG_TUNNEL_SSH_HOST=your-ssh-host
# PG_TUNNEL_LOCAL_HOST=127.0.0.1
# PG_TUNNEL_LOCAL_PORT=15432
# PG_TUNNEL_REMOTE_HOST=your-instance.pg.rds.aliyuncs.com
# PG_TUNNEL_REMOTE_PORT=5432

# Optional SSH tunnel config for PostgreSQL sync jobs
PG_TUNNEL_ENABLED=
PG_TUNNEL_SSH_HOST=
PG_TUNNEL_LOCAL_HOST=
PG_TUNNEL_LOCAL_PORT=15432
PG_TUNNEL_REMOTE_HOST=
PG_TUNNEL_REMOTE_PORT=

# Optional per-job SSH tunnel overrides
# 本地开发默认按服务分配独立端口，避免多个进程同时拉起 SSH tunnel 时争抢同一 listen port。
# auto-collect/theme-api/chat-backend 可通过 PG_TUNNEL_LOCAL_PORT 或各自 PG_PORT 指向对应端口。
PG_SYNC_TUNNEL_LOCAL_HOST=
PG_SYNC_TUNNEL_LOCAL_PORT=15433
PG_SYNC_TUNNEL_PID_FILE=
PG_SYNC_TUNNEL_LOG_FILE=

THEME_FEATURE_SYNC_TUNNEL_LOCAL_HOST=
THEME_FEATURE_SYNC_TUNNEL_LOCAL_PORT=15434
THEME_FEATURE_SYNC_TUNNEL_PID_FILE=
THEME_FEATURE_SYNC_TUNNEL_LOG_FILE=
THEME_FEATURE_SYNC_TUNNEL_KEEPALIVE=true

# Optional per-job overrides
AUTO_COLLECT_DB_PATH=
PG_SYNC_DUCKDB_PATH=
THEME_FEATURE_SYNC_DUCKDB_PATH=
AUTO_COLLECT_EXTRA_ARGS=

# Auto-collect defaults
AUTO_COLLECT_DOMAIN=all
AUTO_COLLECT_INTERVAL_MINUTES=3
AUTO_COLLECT_BATCH_SIZE=50
AUTO_COLLECT_STALE_HOURS=1440
AUTO_COLLECT_ENABLE_TRENDS=true
AUTO_COLLECT_ENABLE_STRATEGY_EXPANSION=true
AUTO_COLLECT_STRATEGY_PENDING_THRESHOLD=200
AUTO_COLLECT_STRATEGY_CATEGORY_LIMIT=2
AUTO_COLLECT_STRATEGY_KEYWORD_LIMIT=5
AUTO_COLLECT_STRATEGY_CATEGORY_COOLDOWN_HOURS=720
AUTO_COLLECT_STRATEGY_KEYWORD_COOLDOWN_HOURS=72
KEEPA_INTERACTIVE_MIN_TOKENS=150
KEEPA_BESTSELLER_MIN_TOKENS=50
KEEPA_SEARCH_MIN_TOKENS=12
KEEPA_HISTORY_MIN_TOKENS=2
KEEPA_SAFE_RESERVE_TOKENS=20
AUTO_COLLECT_MAX_HISTORY_TOKENS_PER_RUN=200
AUTO_HISTORY_PAUSE_WHEN_INTERACTIVE_PENDING=false
AUTO_DISCOVERY_ALLOW_WHEN_PENDING=true

# Sync loop defaults
SYNC_INTERVAL_SECONDS=300
PG_SYNC_TUNNEL_KEEPALIVE=true
PG_SYNC_BATCH_SIZE=2000
PG_SYNC_FETCH_BATCH_SIZE=10000
PG_SYNC_PROGRESS_LOG_FETCH_BATCHES=100
PG_AGG_REFRESH_INTERVAL_SECONDS=3600
PG_SYNC_AGG_PARTITIONED=true
PG_SYNC_AGG_DUCKDB_THREADS=1
PG_SYNC_AGG_DUCKDB_MEMORY_LIMIT=4096MB
PG_SYNC_AGG_PROGRESS_LOG_FETCH_BATCHES=100
THEME_FEATURE_SYNC_INTERVAL_SECONDS=86400
THEME_FEATURE_RETENTION_DAYS=180
THEME_FEATURE_REFRESH_OVERLAP_DAYS=35
THEME_FEATURE_DUCKDB_THREADS=4

# API keys
CENSUS_API_KEY=
UNCOMTRADE_API_KEY=
SEMRUSH_API_KEY=
AHREFS_API_KEY=
KEEPA_API_KEY=

# Optional endpoint overrides
UNCOMTRADE_BASE_URL=https://comtradeapi.worldbank.org/data/v1/get/C/A/HS
EUROSTAT_BASE_URL=https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data
SEMRUSH_BASE_URL=https://api.semrush.com/
AHREFS_BASE_URL=https://api.ahrefs.com/v3
AHREFS_SITE_OVERVIEW_PATH=site-explorer/overview
KEEPA_BASE_URL=https://api.keepa.com/product

# Runtime options
OUTPUT_DIR=outputs
REQUEST_TIMEOUT=60
