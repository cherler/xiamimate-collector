<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xiamimate.auto-collect</string>

    <key>WorkingDirectory</key>
    <string>/path/to/xiamimate-collector</string>

    <key>ProgramArguments</key>
    <array>
        <string>/path/to/xiamimate-runtime/python/.venv/bin/python</string>
        <string>-m</string>
        <string>data_collector.cross_border_data</string>
        <string>auto-collect</string>
        <string>--domain</string>
        <string>all</string>
        <string>--loop</string>
        <string>--interval-minutes</string>
        <string>3</string>
        <string>--batch-size</string>
        <string>50</string>
        <string>--stale-hours</string>
        <string>336</string>
        <string>--lock-file</string>
        <string>/path/to/xiamimate-collector/logs/auto_collect.lock</string>
        <string>--enable-trends</string>
        <string>--enable-strategy-expansion</string>
        <string>--strategy-pending-threshold</string>
        <string>200</string>
        <string>--strategy-category-limit</string>
        <string>2</string>
        <string>--strategy-keyword-limit</string>
        <string>5</string>
        <string>--strategy-category-cooldown-hours</string>
        <string>720</string>
        <string>--strategy-keyword-cooldown-hours</string>
        <string>72</string>
        <string>--db-path</string>
        <string>/path/to/xiamimate-runtime/duckdb/warehouse/local_analytics.duckdb</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/path/to/xiamimate-runtime/python/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONPATH</key>
        <string>/path/to/xiamimate-collector</string>
        <key>PG_HOST</key>
        <string>localhost</string>
        <key>PG_PORT</key>
        <string>5432</string>
        <key>PG_DB</key>
        <string>xiamimate</string>
        <key>PG_USER</key>
        <string>xiamimate</string>
        <key>PG_PASSWORD</key>
        <string>xiamimate</string>
        <key>KEEPA_API_KEY</key>
        <string>KEEPA_API_KEY_REDACTED</string>
        <key>KEEPA_BASE_URL</key>
        <string>https://api.keepa.com/product</string>
        <key>REQUEST_TIMEOUT</key>
        <string>60</string>
        <key>OUTPUT_DIR</key>
        <string>outputs</string>
    </dict>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/path/to/xiamimate-collector/logs/auto_collect.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/xiamimate-collector/logs/auto_collect.log</string>

    <key>AbandonProcessGroup</key>
    <false/>
</dict>
</plist>