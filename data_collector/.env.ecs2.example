# ECS2 collector runtime
XIAMIMATE_PYTHON_BIN=/opt/xiamimate/xiamimate-runtime/python/.venv/bin/python
XIAMIMATE_DUCKDB_PATH=/data/xiamimate/duckdb/live/local_analytics.duckdb
XIAMIMATE_RAW_JSON_ROOT=/data/xiamimate/collector/raw/json
XIAMIMATE_RAW_PRODUCTS_DIR=/data/xiamimate/collector/raw/json/products
XIAMIMATE_RAW_BESTSELLERS_DIR=/data/xiamimate/collector/raw/json/bestsellers
XIAMIMATE_LOG_DIR=/data/xiamimate/collector/logs
XIAMIMATE_DUCKDB_ACCESS_LOCK_FILE=/data/xiamimate/collector/logs/duckdb_live_access.lock
XIAMIMATE_DUCKDB_ACCESS_LOCK_TIMEOUT_SECONDS=900
XIAMIMATE_INIT_SYNC_TABLES_SQL=/opt/xiamimate/xiamimate-data-infra/postgres/init_sync_tables.sql

# PostgreSQL target
PG_HOST=
PG_PORT=5432
PG_DB=xiamimate
PG_USER=
PG_PASSWORD=
PG_TUNNEL_ENABLED=0

# auto-collect
AUTO_COLLECT_DOMAIN=all
AUTO_COLLECT_INTERVAL_MINUTES=3
AUTO_COLLECT_BATCH_SIZE=25
AUTO_HISTORY_MAX_BATCHES_PER_RUN=1
AUTO_COLLECT_STALE_HOURS=1440
AUTO_COLLECT_ENABLE_TRENDS=true
# 可选：ECS2 若不能直连 trends.google.com，配置可用 HTTP(S) 代理后保留 AUTO_COLLECT_ENABLE_TRENDS=true。
# GOOGLE_TRENDS_PROXY_URL=http://127.0.0.1:7890
AUTO_GOOGLE_TRENDS_BATCH_SIZE=5
AUTO_GOOGLE_TRENDS_MAX_BATCHES_PER_RUN=1
AUTO_GOOGLE_TRENDS_MAX_KEYWORDS_PER_RUN=5
AUTO_GOOGLE_TRENDS_REQUEST_INTERVAL_SECONDS=60
AUTO_GOOGLE_TRENDS_COOLDOWN_SECONDS=180
AUTO_GOOGLE_TRENDS_CONNECT_TIMEOUT_SECONDS=5
AUTO_GOOGLE_TRENDS_READ_TIMEOUT_SECONDS=20
# 可选：遇到 429/timeout 时调用 Mihomo controller 切到下一节点后再冷却 3 分钟。
AUTO_GOOGLE_TRENDS_MIHOMO_CONTROLLER_URL=http://127.0.0.1:9090
# Mihomo 节点切换分组：新订阅配置的可切换分组名为「🔰节点选择」。
AUTO_GOOGLE_TRENDS_MIHOMO_SWITCH_GROUP=🔰节点选择
# 可选：主动养 IP。每成功采集 N 批就主动切到下一个 Mihomo 节点，分摊单 IP 请求频率。
# 0 = 关闭主动轮换（仅在 429/网络异常时被动切换）。建议 2~3。
AUTO_GOOGLE_TRENDS_ROTATE_EVERY_N_BATCHES=2
# 可选：替代数据源兜底。pytrends 直连/代理持续失败时改用 SerpApi 的 google_trends 引擎。
# 配置 SERPAPI_API_KEY 后自动启用（provider 默认 serpapi）；留空则兜底关闭，不影响主链路。
# AUTO_GOOGLE_TRENDS_FALLBACK_PROVIDER=serpapi
# SERPAPI_API_KEY=
AUTO_COLLECT_ENABLE_STRATEGY_EXPANSION=true
AUTO_COLLECT_STRATEGY_PENDING_THRESHOLD=200
AUTO_COLLECT_STRATEGY_CATEGORY_LIMIT=2
AUTO_COLLECT_STRATEGY_KEYWORD_LIMIT=5
AUTO_COLLECT_STRATEGY_CATEGORY_COOLDOWN_HOURS=720
AUTO_COLLECT_STRATEGY_KEYWORD_COOLDOWN_HOURS=72
KEEPA_INTERACTIVE_MIN_TOKENS=150
KEEPA_BESTSELLER_MIN_TOKENS=50
KEEPA_SEARCH_MIN_TOKENS=12
KEEPA_HISTORY_MIN_TOKENS=2
KEEPA_SAFE_RESERVE_TOKENS=20
AUTO_COLLECT_MAX_HISTORY_TOKENS_PER_RUN=200
AUTO_HISTORY_PAUSE_WHEN_INTERACTIVE_PENDING=false
AUTO_DISCOVERY_ALLOW_WHEN_PENDING=true

# pg-sync
SYNC_INTERVAL_SECONDS=300
PG_SYNC_BATCH_SIZE=2000
PG_SYNC_FETCH_BATCH_SIZE=10000
PG_SYNC_PROGRESS_LOG_FETCH_BATCHES=100
PG_SYNC_DUCKDB_THREADS=1
PG_SYNC_DUCKDB_MEMORY_LIMIT=1536MB
PG_SYNC_DUCKDB_READ_MODE=direct
PG_SYNC_DUCKDB_SOURCE=live
PG_SYNC_REFRESH_SNAPSHOT=false
PG_SYNC_INCLUDE_HISTORY=true
PG_SYNC_HISTORY_REFRESH_SNAPSHOT=false
PG_SYNC_AGG_REFRESH_SNAPSHOT=false
PG_SYNC_AGG_MODE=incremental
PG_SYNC_AGG_LOOKBACK_DAYS=14
PG_SYNC_AGG_INITIAL_LOOKBACK_DAYS=14
PG_SYNC_AGG_INCREMENTAL_DATE_DAYS=45
PG_SYNC_AGG_MAX_AFFECTED_BUCKETS=90
PG_SYNC_AGG_MONTH_PARTITION_DOMAINS=1
PG_SYNC_AGG_USE_SUBSET_DUCKDB=true
PG_SYNC_AGG_SUBSET_DIR=/data/xiamimate/collector/logs/pg_agg_incremental_subsets
PG_SYNC_AGG_PARTITIONED=true
PG_SYNC_AGG_HISTORY_DAYS=1095
PG_SYNC_AGG_DUCKDB_THREADS=1
PG_SYNC_AGG_DUCKDB_MEMORY_LIMIT=8192MB
PG_SYNC_AGG_PROGRESS_LOG_FETCH_BATCHES=100
# 补池 reconcile 完成后由 run_pg_sync_once.sh 在释放 live 锁之后串行触发 scoped serving refresh。
# 设为 false 可禁用该 deferred 触发；默认 true。
PG_SYNC_TRIGGER_THEME_SYNC_ON_EXPANSION_RECONCILE=true
# 日常 pg-sync 包含 curated.keepa_product_history；agg full refresh 仍由周日低频任务负责。
PG_SYNC_SKIP_TABLES=agg.keepa_history_domain_daily,agg.keepa_history_root_category_daily
XIAMIMATE_PG_SYNC_TIMER_INTERVAL=5min
XIAMIMATE_PG_AGG_SYNC_TIMER_CALENDAR="Sun *-*-* 04:00:00"
XIAMIMATE_PG_AGG_SYNC_TIMEOUT_START_SEC=3h

# theme-sync
THEME_FEATURE_SYNC_INTERVAL_SECONDS=86400
THEME_FEATURE_DUCKDB_THREADS=1
THEME_FEATURE_DUCKDB_READ_MODE=direct
THEME_FEATURE_SYNC_REFRESH_SNAPSHOT=true
THEME_FEATURE_REFRESH_OVERLAP_DAYS=7
XIAMIMATE_THEME_SYNC_TIMER_CALENDAR="*-*-* 01:00:00"

# candidate expansion fast refresh
CANDIDATE_EXPANSION_DUCKDB_SOURCE=live
CANDIDATE_EXPANSION_REFRESH_SNAPSHOT=false
CANDIDATE_EXPANSION_DUCKDB_SUBSET_DIR=/data/xiamimate/collector/logs/candidate_expansion_duckdb_subsets
CANDIDATE_EXPANSION_DUCKDB_ACCESS_LOCK_TIMEOUT_SECONDS=900
CANDIDATE_EXPANSION_DUCKDB_OPEN_RETRIES=30
CANDIDATE_EXPANSION_DUCKDB_OPEN_RETRY_DELAY_SECONDS=2
CANDIDATE_EXPANSION_RUN_PG_SYNC=true
# CANDIDATE_EXPANSION_JOB_IDS is usually passed by pg-sync reconcile.
CANDIDATE_EXPANSION_THEME_OVERLAP_DAYS=7
# Health-check janitor prunes subset DuckDB leftovers older than this many minutes.
CANDIDATE_EXPANSION_DUCKDB_SUBSET_TTL_MINUTES=360

# ECS2 healthcheck monitoring
XIAMIMATE_COLLECTOR_HEALTHCHECK_INTERVAL=5min
XIAMIMATE_COLLECTOR_HEALTHCHECK_DATA_MOUNT=/data
XIAMIMATE_COLLECTOR_HEALTHCHECK_DISK_WARN_PCT=85
XIAMIMATE_COLLECTOR_HEALTHCHECK_DISK_ERROR_PCT=95
XIAMIMATE_COLLECTOR_HEALTHCHECK_NOTIFY_ENABLED=true
XIAMIMATE_COLLECTOR_HEALTHCHECK_NOTIFY_COOLDOWN_SECONDS=3600
XIAMIMATE_COLLECTOR_HEALTHCHECK_NOTIFY_RECOVERY=1
XIAMIMATE_COLLECTOR_HEALTHCHECK_NOTIFY_STATE_FILE=/data/xiamimate/collector/logs/collector_healthcheck_notify_state.json
# FEISHU_WEBHOOK_URL should be copied from the ECS2 control-plane env if notification is enabled.

# raw cleanup lifecycle
RAW_JSON_RETENTION_DAYS=7
RAW_PRODUCTS_RETENTION_DAYS=7

# DuckDB snapshot publisher
XIAMIMATE_DUCKDB_SNAPSHOT_BASE_DIR=/data/xiamimate/duckdb/snapshots
XIAMIMATE_DUCKDB_SNAPSHOT_RUNS_DIR=/data/xiamimate/duckdb/snapshots/runs
XIAMIMATE_DUCKDB_SNAPSHOT_CURRENT_LINK=/data/xiamimate/duckdb/snapshots/current
XIAMIMATE_DUCKDB_SNAPSHOT_RETENTION_COUNT=1
XIAMIMATE_DUCKDB_SNAPSHOT_SHA256=false
XIAMIMATE_DUCKDB_SNAPSHOT_COPY_WAL=false

# Forecast weekly snapshot for Winlab. This is separate from the rolling pg-sync snapshot.
FORECAST_SNAPSHOT_MODE=feature_parquet
FORECAST_DUCKDB_SNAPSHOT_BASE_DIR=/data/xiamimate/duckdb/forecast_snapshots
FORECAST_DUCKDB_SNAPSHOT_RUNS_DIR=/data/xiamimate/duckdb/forecast_snapshots/runs
FORECAST_DUCKDB_SNAPSHOT_CURRENT_LINK=/data/xiamimate/duckdb/forecast_snapshots/current
FORECAST_DUCKDB_SNAPSHOT_RETENTION_COUNT=1
FORECAST_DUCKDB_SNAPSHOT_COPY_MODE=auto
FORECAST_FEATURE_EXPORT_BASE_DIR=/data/xiamimate/forecast_feature_exports
FORECAST_FEATURE_EXPORT_SOURCE_DB=/data/xiamimate/duckdb/snapshots/current/local_analytics.duckdb
FORECAST_FEATURE_EXPORT_DOMAINS="1 9 10 11 12 13"
FORECAST_FEATURE_EXPORT_HISTORY_DAYS=365
FORECAST_FEATURE_EXPORT_RETENTION_COUNT=1
FORECAST_FEATURE_EXPORT_REPORT_RDS=true
FORECAST_SNAPSHOT_ENQUEUE_TRAINING_RUN=true
XIAMIMATE_FORECAST_SNAPSHOT_TIMER_CALENDAR="Sun *-*-* 02:30:00"
